# Copier ce fichier en .env et remplir les valeurs. Ne jamais commiter .env.

# Clé secrète Django (obligatoire en production).
# Générer : python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=

# Mettre False en production
DJANGO_DEBUG=True

# Hôtes autorisés, séparés par des virgules
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# Clés Stripe (paiement par carte) — https://dashboard.stripe.com/apikeys
STRIPE_PUBLIC_KEY=
STRIPE_SECRET_KEY=
