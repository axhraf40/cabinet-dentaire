+@login_required
+@secretaire_required
+def patient_create(request):
+    if request.method == 'POST':
+        form = UserRegistrationForm(request.POST)
+        if form.is_valid():
+            form.save()
+            messages.success(request, 'Le patient a été créé avec succès !')
+            return redirect('patient_list')
+    else:
+        form = UserRegistrationForm()
+    return render(request, 'gestion_cabinet/patient_register.html', {'form': form})
+
+@login_required
+def rendez_vous_annuler(request, pk):
+    rendez_vous = get_object_or_404(RendezVous, pk=pk)
+    user = request.user
+    autorise = user.is_secretaire or user.is_dentiste or (
+        user.is_patient and rendez_vous.patient == user.patient_profile)
+    if not autorise:
+        messages.error(request, "Vous n'avez pas accès à ce rendez-vous.")
+        return redirect('dashboard')
+    rendez_vous.statut = 'ANNULE'
+    rendez_vous.save()
+    messages.success(request, 'Le rendez-vous a été annulé.')
+    return redirect(request.META.get('HTTP_REFERER') or 'rendez_vous_list')
+
+class MontantRdvForm(forms.ModelForm):
+    class Meta:
+        model = RendezVous
+        fields = ['montant']
+        widgets = {'montant': forms.NumberInput(attrs={'step': '0.01', 'min': '0'})}
+
+@login_required
+@secretaire_required
+def definir_montant_rdv(request, rdv_id):
+    rendez_vous = get_object_or_404(RendezVous, id=rdv_id)
+    if request.method == 'POST':
+        form = MontantRdvForm(request.POST, instance=rendez_vous)
+        if form.is_valid():
+            form.save()
+            messages.success(request, 'Montant enregistré.')
+            return redirect('rendez_vous_list')
+    else:
+        form = MontantRdvForm(instance=rendez_vous)
+    return render(request, 'gestion_cabinet/definir_montant_form.html', {'form': form, 'rendez_vous': rendez_vous})
+
+@login_required
+@secretaire_required
+def marquer_rdv_paye(request, rdv_id):
+    rendez_vous = get_object_or_404(RendezVous, id=rdv_id)
+    rendez_vous.statut_paiement = 'REGLE'
+    rendez_vous.save()
+    messages.success(request, 'Rendez-vous marqué comme réglé.')
+    return redirect('rendez_vous_list')
+
+def _changer_mot_de_passe(request, user, titre, retour):
+    if request.method == 'POST':
+        form = AdminPasswordChangeForm(user, request.POST)
+        if form.is_valid():
+            form.save()
+            messages.success(request, 'Mot de passe modifié avec succès !')
+            return redirect(retour)
+    else:
+        form = AdminPasswordChangeForm(user)
+    return render(request, 'gestion_cabinet/admin_change_password.html', {'form': form, 'title': titre})
+
+@login_required
+@secretaire_required
+def patient_change_password(request, patient_id):
+    patient = get_object_or_404(Patient, id=patient_id)
+    return _changer_mot_de_passe(request, patient.user, f"Mot de passe de {patient}", 'patient_list')
+
+@login_required
+@role_required(['DENTISTE', 'SECRETAIRE'])
+def secretaire_change_password(request, secretaire_id):
+    secretaire = get_object_or_404(Secretaire, id=secretaire_id)
+    return _changer_mot_de_passe(request, secretaire.user, f"Mot de passe de {secretaire}", 'secretaire_list')
